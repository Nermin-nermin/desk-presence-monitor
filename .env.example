# Copy to .env (git-ignored) and fill in. Never commit .env.
# Use the camera's SUB-STREAM (e.g. 720p) - plenty for desk detection and much cheaper to decode.
#
# Hikvision:  rtsp://USER:PASSWORD@IP:554/Streaming/Channels/102
# Dahua:      rtsp://USER:PASSWORD@IP:554/cam/realmonitor?channel=1&subtype=1
#
# If the password contains special characters (@ : / ? # %), URL-encode them, e.g. @ -> %40
CAM1_URL=rtsp://USER:PASSWORD@192.168.1.64:554/Streaming/Channels/102
